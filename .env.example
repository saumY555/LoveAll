# ==============================================================================
# AI-Powered Collaborative Event Photo Gallery - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Free Cloud Option: Sign up at https://neon.tech or https://supabase.com for instant $0 PostgreSQL
# Local Docker Option: docker run --name photo-event-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photo_event_gallery?schema=public"
# Direct / Unpooled URL (used for migrations on Neon / Supabase)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/photo_event_gallery?schema=public"

# ------------------------------------------------------------------------------
# 2. NextAuth / Auth.js Configuration
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-minimum-32-chars-long"
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL="http://localhost:3000" # Omit or leave commented for dynamic tunnel / LAN host detection

# ------------------------------------------------------------------------------
# 3. Google OAuth Credentials
# ------------------------------------------------------------------------------
# Create at: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. Development-Only Authentication Shortcut
# ------------------------------------------------------------------------------
# WARNING: Only enables the /api/dev-auth shortcut when NODE_ENV === 'development'.
# This allows quick local testing without live Google OAuth keys.
# It is completely ignored and strictly forbidden (HTTP 403) in production builds.
ENABLE_DEV_AUTH_SHORTCUT="true"

# ------------------------------------------------------------------------------
# 5. File Storage Provider
# ------------------------------------------------------------------------------
# "local" for local disk storage (zero cost, private storage/ directory)
# "s3" for S3-compatible cloud object storage (Cloudflare R2, AWS S3, MinIO)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_PATH="./storage"

# S3 Configuration (only needed if STORAGE_PROVIDER="s3")
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="event-photos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# ------------------------------------------------------------------------------
# 6. Face Processing Worker Configuration
# ------------------------------------------------------------------------------
# ONNX intra-op threads (recommended: number of physical P-cores, e.g. 6)
FACE_THREADS="6"
# Python executable path (optional, defaults to "python")
PYTHON_PATH="python"
